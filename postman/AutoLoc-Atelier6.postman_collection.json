{
  "info": {
    "name": "AutoLoc Atelier 6 - DTO et validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Client valide → 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clients",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Demo\",\n  \"prenom\": \"Alice\",\n  \"email\": \"alice@example.com\",\n  \"telephone\": \"20123456\",\n  \"numPermis\": \"P001\",\n  \"dateInscription\": \"2020-01-01\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"clientId\", pm.response.json().idClient);"
            ]
          }
        }
      ]
    },
    {
      "name": "Client DTO → 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/clients/{{clientId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Validation champs → 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clients",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"\",\n  \"email\": \"incorrect\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Identifiant absent → 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/clients/9223372036854775807"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Dates inversées → 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dateDebut\": \"2030-02-02\",\n  \"dateFin\": \"2030-01-01\",\n  \"statut\": \"EN_ATTENTE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Supprimer client démo → 204",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/clients/{{clientId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}